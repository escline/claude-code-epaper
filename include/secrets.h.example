#pragma once

// Copy this file to include/secrets.h and fill in your values.
// include/secrets.h is gitignored.

#define WIFI_SSID "your-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// MQTT broker on your LAN. Use the IP if mDNS is unreliable on your network.
#define MQTT_HOST "192.168.1.10"
#define MQTT_PORT 1883

// Leave as empty strings if your broker allows anonymous access.
#define MQTT_USER ""
#define MQTT_PASSWORD ""

// Must be unique on the broker.
#define MQTT_CLIENT_ID "claude-epaper"

// Location for the weather screen, in decimal degrees. South and west are
// negative. Look yours up at https://open-meteo.com/en/docs (the search box
// prints the coordinates) or from any map app.
//
// This lives in secrets.h rather than config.h purely so your home
// coordinates stay out of the repository. Four decimal places is ~11 m, which
// is far more than a weather forecast resolves - two is plenty.
#define WEATHER_LAT 41.88
#define WEATHER_LON -87.63
